{
  "name": "TuCanchera - Webhook MercadoPago",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mp-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-mp",
      "name": "Webhook MercadoPago",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300],
      "webhookId": "mp-webhook",
      "notes": "MercadoPago llama a este endpoint cuando hay un evento de pago. URL a configurar en el dashboard de MP."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "operation": "equals",
              "value2": "payment"
            }
          ]
        }
      },
      "id": "if-payment",
      "name": "¿Es evento de pago?",
      "type": "n8n-nodes-base.if",
      "position": [460, 300],
      "notes": "MP envía distintos tipos de eventos. Solo procesar los de tipo 'payment'."
    },
    {
      "parameters": {
        "url": "=https://api.mercadopago.com/v1/payments/{{ $json.data.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MP_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "verificar-pago-mp",
      "name": "Verificar pago en MP",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 200],
      "notes": "Consulta la API de MP para obtener el estado real del pago (nunca confiar solo en el webhook)"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "approved"
            }
          ]
        }
      },
      "id": "if-approved",
      "name": "¿Pago aprobado?",
      "type": "n8n-nodes-base.if",
      "position": [900, 200],
      "notes": "Solo actuar si el pago fue aprobado. Ignorar pending, rejected, etc."
    },
    {
      "parameters": {
        "jsCode": "const pago = $input.first().json;\n// El external_reference es el ID de la reserva que se guardó al crear la preferencia\nconst reservaId = pago.external_reference;\nconst mpPaymentId = String(pago.id);\n\nreturn [{ json: { reserva_id: reservaId, mp_payment_id: mpPaymentId } }];"
      },
      "id": "extraer-reserva-id",
      "name": "Extraer ID de reserva",
      "type": "n8n-nodes-base.code",
      "position": [1120, 120],
      "notes": "El external_reference de MP debe contener el ID de la reserva. Se guarda al crear la preferencia en la Edge Function."
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/reservas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $json.reserva_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"estado\": \"confirmada\",\n  \"mp_payment_id\": \"{{ $json.mp_payment_id }}\"\n}"
      },
      "id": "actualizar-reserva",
      "name": "Confirmar reserva en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "method": "PATCH",
      "position": [1340, 120],
      "notes": "Actualiza la reserva a 'confirmada' y guarda el ID del pago de MP. Usa service key para bypass de RLS."
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/reservas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $json[0].id }}"
            },
            {
              "name": "select",
              "value": "*, canchas(nombre, tipo, complejos(nombre, direccion, admin_id, profiles!admin_id(telefono))), profiles!cliente_id(nombre, telefono)"
            }
          ]
        }
      },
      "id": "fetch-datos-notificacion",
      "name": "Obtener datos para notificación",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1560, 120],
      "notes": "Trae todos los datos necesarios para armar los mensajes de WhatsApp"
    },
    {
      "parameters": {
        "jsCode": "const reserva = $input.first().json[0];\nconst cliente = reserva.profiles;\nconst cancha = reserva.canchas;\nconst complejo = cancha.complejos;\nconst adminTelefono = complejo.profiles?.telefono;\n\nconst fecha = new Date(reserva.fecha + 'T00:00:00');\nconst fechaFormateada = fecha.toLocaleDateString('es-AR', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'\n});\n\nconst horaInicio = reserva.hora_inicio.slice(0, 5);\nconst horaFin = reserva.hora_fin.slice(0, 5);\n\nreturn [{\n  json: {\n    telefono_cliente: cliente.telefono,\n    telefono_admin: adminTelefono,\n    mensaje_cliente: `✅ *¡Pago confirmado y reserva asegurada!*\\n\\n🏟️ *${complejo.nombre}*\\n⚽ *Cancha:* ${cancha.nombre}\\n📅 *${fechaFormateada}*\\n⏰ *${horaInicio} a ${horaFin}*\\n\\n📍 ${complejo.direccion || ''}\\n\\n¡Te esperamos! 🎉`,\n    mensaje_admin: `💰 *Pago recibido por MercadoPago*\\n\\n👤 ${cliente.nombre}\\n📞 ${cliente.telefono || 'S/N'}\\n⚽ ${cancha.nombre}\\n📅 ${fechaFormateada}\\n⏰ ${horaInicio} a ${horaFin}\\n\\n✅ Reserva confirmada automáticamente`\n  }\n}];"
      },
      "id": "formatear-mensajes-pago",
      "name": "Formatear mensajes",
      "type": "n8n-nodes-base.code",
      "position": [1780, 120]
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefono_cliente }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"{{ $json.mensaje_cliente }}\" }\n}"
      },
      "id": "whatsapp-cliente-pago",
      "name": "WhatsApp cliente (pago confirmado)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2000, 60]
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefono_admin }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"{{ $json.mensaje_admin }}\" }\n}"
      },
      "id": "whatsapp-admin-pago",
      "name": "WhatsApp admin (nuevo pago)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2000, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }"
      },
      "id": "respuesta-mp",
      "name": "Responder OK a MercadoPago",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [2220, 140],
      "notes": "MP requiere respuesta 200 en menos de 5 segundos o reintenta el webhook"
    }
  ],
  "connections": {
    "Webhook MercadoPago": {
      "main": [[ { "node": "¿Es evento de pago?", "type": "main", "index": 0 } ]]
    },
    "¿Es evento de pago?": {
      "main": [
        [ { "node": "Verificar pago en MP", "type": "main", "index": 0 } ],
        []
      ]
    },
    "Verificar pago en MP": {
      "main": [[ { "node": "¿Pago aprobado?", "type": "main", "index": 0 } ]]
    },
    "¿Pago aprobado?": {
      "main": [
        [ { "node": "Extraer ID de reserva", "type": "main", "index": 0 } ],
        []
      ]
    },
    "Extraer ID de reserva": {
      "main": [[ { "node": "Confirmar reserva en Supabase", "type": "main", "index": 0 } ]]
    },
    "Confirmar reserva en Supabase": {
      "main": [[ { "node": "Obtener datos para notificación", "type": "main", "index": 0 } ]]
    },
    "Obtener datos para notificación": {
      "main": [[ { "node": "Formatear mensajes", "type": "main", "index": 0 } ]]
    },
    "Formatear mensajes": {
      "main": [[
        { "node": "WhatsApp cliente (pago confirmado)", "type": "main", "index": 0 },
        { "node": "WhatsApp admin (nuevo pago)", "type": "main", "index": 0 }
      ]]
    },
    "WhatsApp cliente (pago confirmado)": {
      "main": [[ { "node": "Responder OK a MercadoPago", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["tucanchera", "mercadopago", "pagos", "whatsapp"]
}
